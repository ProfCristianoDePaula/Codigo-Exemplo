@model IEnumerable<ClinicaVet.Models.Agendamento>
@{ViewData["Title"]="Agendamentos";}<h1>Agendamentos</h1><p><a asp-action="Create" class="btn btn-primary">Novo agendamento</a></p><table class="table"><thead><tr><th>Data e hora</th><th>Serviço</th><th>Pet</th><th>Tutor</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.DataHora.ToString("dd/MM/yyyy HH:mm")</td><td>@x.Servico</td><td>@x.Pet?.Nome</td><td>@x.Pet?.Tutor?.Nome</td><td><a asp-action="Edit" asp-route-id="@x.Id">Editar</a> | <a asp-action="Delete" asp-route-id="@x.Id">Excluir</a></td></tr>}</tbody></table>
