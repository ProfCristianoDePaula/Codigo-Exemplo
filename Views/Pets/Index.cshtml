@model IEnumerable<ClinicaVet.Models.Pet>
@{ViewData["Title"]="Pets";}<h1>Pets</h1><p><a asp-action="Create" class="btn btn-primary">Novo pet</a></p>@if(TempData["Erro"] is string erro){<div class="alert alert-warning">@erro</div>}<table class="table"><thead><tr><th>Nome</th><th>Espécie</th><th>Nascimento</th><th>Tutor</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Nome</td><td>@x.Especie</td><td>@x.DataNascimento?.ToString("dd/MM/yyyy")</td><td>@x.Tutor?.Nome</td><td><a asp-action="Edit" asp-route-id="@x.Id">Editar</a> | <a asp-action="Delete" asp-route-id="@x.Id">Excluir</a></td></tr>}</tbody></table>
