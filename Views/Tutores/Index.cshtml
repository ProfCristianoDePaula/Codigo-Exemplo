@model IEnumerable<ClinicaVet.Models.Tutor>
@{ViewData["Title"]="Tutores";}
<h1>Tutores</h1><form method="get" class="d-flex gap-2 mb-3"><input name="termo" value="@ViewData["Termo"]" class="form-control" placeholder="Buscar por nome ou e-mail"/><button class="btn btn-outline-primary">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpar</a></form><p><a asp-action="Create" class="btn btn-primary">Novo tutor</a></p>
@if(TempData["Erro"] is string erro){<div class="alert alert-warning">@erro</div>}
<table class="table"><thead><tr><th>Nome</th><th>E-mail</th><th>Telefone</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Nome</td><td>@x.Email</td><td>@x.Telefone</td><td><a asp-action="Edit" asp-route-id="@x.Id">Editar</a> | <a asp-action="Delete" asp-route-id="@x.Id">Excluir</a></td></tr>}</tbody></table>
